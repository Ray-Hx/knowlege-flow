# ===========================================
# KnowledgeFlow Docker 环境配置
# ===========================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=knowledge_flow
MYSQL_USER=kflow
MYSQL_PASSWORD=kflow_password_change_me
MYSQL_PORT=3306

# Redis 配置
REDIS_PORT=6379

# Elasticsearch 配置
ES_PORT=9200

# Neo4j 配置
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Qdrant 配置
QDRANT_PORT=6333

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# RabbitMQ 配置
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin_password_change_me
RABBITMQ_VHOST=knowledge_flow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 应用运行密钥（不要提交真实值）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-chat
QWEN_API_KEY=
ZHIPUAI_API_KEY=
JWT_SECRET=
